config_version=5

[application]
config/name="B.S. Vice City"
run/main_scene="res://scenes/Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
action={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
job={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
shop={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":9)]
}
map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
exit_vehicle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":88)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.45, 0.68, 0.86, 1)
